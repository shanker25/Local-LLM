# ---- Model --------------------------------------------------------------
MODEL_NAME=llama3.2:1b

# ---- Ollama -------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
REQUEST_TIMEOUT=120

# ---- Sessions (Milestone 3) --------------------------------------------
# Directory where per-session JSON files and index.json live.
SESSION_DIR=data/sessions

# Session created/loaded when no prior active session exists.
DEFAULT_SESSION=default

# Maximum number of non-system messages sent to the model.
# Older messages remain on disk; this only affects the request payload.
MAX_CONTEXT_MESSAGES=40

# If true, JARVIS resumes the last active session on startup.
AUTO_RESUME=true